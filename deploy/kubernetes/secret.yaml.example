# Copy to secret.yaml, fill values, kubectl apply -f secret.yaml
# Do not commit real secrets.
apiVersion: v1
kind: Secret
metadata:
  name: mulat-secrets
  namespace: ai-agents
type: Opaque
stringData:
  LLM_API_KEY: "REPLACE_ME"
  DATABASE_URL: "postgresql://user:pass@postgres:5432/mulat"
  # Only when using K8S_API_SERVER + token instead of pod ServiceAccount
  K8S_TOKEN: "REPLACE_ME"
