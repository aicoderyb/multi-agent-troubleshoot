        {
          "name": "Right-sizing (K8s + Prometheus)",
          "item": [
            {
              "name": "get_requests_limits — GET /api/v1/pods",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{k8sToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{k8sServer}}/api/v1/pods?limit=200",
                  "host": ["{{k8sServer}}"],
                  "path": ["api", "v1", "pods"],
                  "query": [
                    {
                      "key": "limit",
                      "value": "200"
                    },
                    {
                      "key": "labelSelector",
                      "value": "",
                      "disabled": true
                    }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "query_cpu_usage — Prometheus instant query",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{prometheusUrl}}/api/v1/query?query=quantile_over_time(0.95,(sum%20by%20(namespace,pod,container)%20(rate(container_cpu_usage_seconds_total%7Bcontainer!%3D%22%22,container!%3D%22POD%22%7D%5B5m%5D)))%5B7d:5m%5D)",
                  "host": ["{{prometheusUrl}}"],
                  "path": ["api", "v1", "query"],
                  "query": [
                    {
                      "key": "query",
                      "value": "quantile_over_time(0.95,(sum by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m])))[7d:5m])"
                    }
                  ]
                },
                "description": "Same PromQL pattern as Tool_API.md query_cpu_usage (p95 / 7d)."
              },
              "response": []
            },
            {
              "name": "query_memory_usage — Prometheus instant query",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{prometheusUrl}}/api/v1/query?query=max_over_time((max%20by%20(namespace,pod,container)%20(container_memory_working_set_bytes%7Bcontainer!%3D%22%22,container!%3D%22POD%22%7D))%5B7d:5m%5D)",
                  "host": ["{{prometheusUrl}}"],
                  "path": ["api", "v1", "query"],
                  "query": [
                    {
                      "key": "query",
                      "value": "max_over_time((max by (namespace,pod,container) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"}))[7d:5m])"
                    }
                  ]
                }
              },
              "response": []
            }
          ]
